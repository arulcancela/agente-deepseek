# ============================================================================
# Agente DeepSeek — Plantilla de configuración
# ============================================================================
# El agente lee la API key de la variable de entorno DEEPSEEK_API_KEY.
# NO hardcodees la clave en el código ni la subas a Git.
#
# Opción 1: exportar en tu shell antes de ejecutar
#   export DEEPSEEK_API_KEY="sk-tu-clave-aqui"
#
# Opción 2: copiar este archivo a .env (si usas un cargador de .env)
# ============================================================================

DEEPSEEK_API_KEY=sk-tu-clave-aqui

# URL base de la API (por defecto, DeepSeek).
# DEEPSEEK_BASE_URL=https://api.deepseek.com
